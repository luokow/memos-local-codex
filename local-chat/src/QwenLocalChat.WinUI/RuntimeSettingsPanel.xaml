<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="QwenLocalChat_WinUI.RuntimeSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="SettingsRoot">
        <Border
            x:Name="PanelShell"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource RaisedBrush}"
            BorderThickness="0">
            <Grid x:Name="SettingsPageColumn" AutomationProperties.AutomationId="SettingsPageColumn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="36,24,36,16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="SettingsHeaderStack" MaxWidth="1064" HorizontalAlignment="Stretch" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="模型设置" Style="{StaticResource SettingsPageTitleStyle}" />
                            <SelectorBar x:Name="SettingsSectionSelector" AutomationProperties.AutomationId="SettingsSectionSelector" SelectionChanged="SettingsSectionSelector_SelectionChanged">
                                <SelectorBarItem x:Name="TextSettingsSectionItem" Text="文本模型" />
                                <SelectorBarItem x:Name="VideoSettingsSectionItem" Text="视频模型" />
                                <SelectorBarItem x:Name="HanhuaSettingsSectionItem" Text="汉化" />
                            </SelectorBar>
                        </StackPanel>
                        <Button Grid.Column="1" AutomationProperties.AutomationId="CloseSettingsButton" AutomationProperties.Name="关闭设置" Content="关闭" Click="CloseButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="关闭面板；若有未保存修改会先确认" VerticalAlignment="Top" />
                    </Grid>
                    <toolkit:SettingsCard Header="保存后何时生效" Description="点「保存」先写入磁盘。即时：下一句对话就用新参数。需重启：要先停止模型再打开软件，新参数才会进模型进程。" />
                </StackPanel>

                <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsCardStack" MaxWidth="1064" HorizontalAlignment="Stretch" Padding="0,2,6,8" Spacing="4">
                        <TextBlock Text="启动与驻留" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,8,0,2" />
                        <toolkit:SettingsCard Header="打开后显示" Description="未完成的汉化或视频只提示，不改页面。">
                            <ComboBox x:Name="StartupPageBox" AutomationProperties.AutomationId="StartupPageSetting" AutomationProperties.Name="打开应用后显示的页面" MinWidth="160">
                                <ComboBoxItem Content="聊天" Tag="chat" />
                                <ComboBoxItem Content="视频" Tag="video" />
                                <ComboBoxItem Content="汉化" Tag="hanhua" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="打开应用后启动" Description="下面再决定是否启动模型。">
                            <ComboBox x:Name="StartupModelBox" AutomationProperties.AutomationId="StartupModelSetting" AutomationProperties.Name="打开应用后启动的模型" MinWidth="160">
                                <ComboBoxItem Content="文本模型" Tag="text" />
                                <ComboBoxItem Content="视频模型" Tag="video" />
                                <ComboBoxItem Content="不自动启动" Tag="none" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="聊天、视频与汉化显存互斥">
                            <ToggleSwitch x:Name="ModelExclusivityToggle" AutomationProperties.AutomationId="ModelExclusivitySetting" AutomationProperties.Name="聊天、视频与汉化显存互斥" OnContent="开启" OffContent="关闭" />
                        </toolkit:SettingsCard>

                        <StackPanel x:Name="TextSettingsSection" Spacing="4">
                            <TextBlock Text="当前文本模型" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <toolkit:SettingsCard Header="模型档案" Description="名称、API model 和启动参数均来自档案。">
                                <ComboBox x:Name="TextModelProfileBox" AutomationProperties.AutomationId="TextModelProfileSetting" AutomationProperties.Name="当前文本模型" MinWidth="220" DisplayMemberPath="DisplayName" SelectionChanged="TextModelProfileBox_SelectionChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="档案说明" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="首次发送时会按需启动；也可先启动检查服务。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TextModelProfileDetails" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <Border x:Name="TextSettingsRecordHost" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TextModelSettingsCardTitle" Text="此模型的设置记录" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TextModelSettingsCardSummary" AutomationProperties.AutomationId="TextModelSettingsCardSummary" Text="生成、历史轮数和附件按当前档案单独保存。切换档案后，下面的设置换成该档案自己的记录。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TextModelOperationStatus" AutomationProperties.AutomationId="TextModelOperationStatus" Style="{StaticResource SettingsSectionHintStyle}" />
                            <toolkit:SettingsCard Header="模型文件">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="TextImportButton" MinWidth="120" AutomationProperties.AutomationId="TextImportButton" AutomationProperties.Name="选择本地文本模型目录" Content="选择本地目录" Click="TextImportButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ReleaseTextModelButton" MinWidth="120" AutomationProperties.AutomationId="ReleaseTextModelButton" AutomationProperties.Name="释放文本模型" Content="释放模型" Click="ReleaseTextModelButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <TextBlock Text="生成" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock Text="即时生效，下一句对话使用" Style="{StaticResource SettingsSectionHintStyle}" Margin="1,0,0,2" />
                            <toolkit:SettingsCard Header="最大输出 Token" Description="默认 4096。须为上下文至少留 512。">
                                <NumberBox x:Name="MaxOutputTokensBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="MaxOutputTokensSetting" AutomationProperties.Name="最大输出 Token" Minimum="128" Maximum="28672" SmallChange="256" LargeChange="1024" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="单次最多生成多少 token。默认 4096；须为上下文至少留 512。超时过短时请求会自动按输出量放宽。" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="温度" Description="越高越发散。长文可试 0.5～0.7。">
                                <NumberBox x:Name="TemperatureBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="TemperatureSetting" AutomationProperties.Name="温度" Minimum="0" Maximum="2" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="越高越发散。长文可试 0.5～0.7" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="请求超时（秒）" Description="默认 900。过短时发送会自动放宽。">
                                <NumberBox x:Name="RequestTimeoutBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="RequestTimeoutSetting" AutomationProperties.Name="请求超时（秒）" Minimum="30" Maximum="1800" SmallChange="30" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 900。若小于「输出÷20+60」保存会提示；发送时也会自动兜底。" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="流式输出">
                                <ToggleSwitch x:Name="StreamResponsesToggle" AutomationProperties.AutomationId="StreamResponsesSetting" AutomationProperties.Name="流式输出" OnContent="开启" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsExpander x:Name="GenerationSettingsExpander" Header="少用的生成项" Description="频率惩罚、DRY 和长文分段。默认关闭。">
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="频率惩罚" Description="默认 0。复读严重时可试 0.3～0.5。">
                                        <NumberBox x:Name="FrequencyPenaltyBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="FrequencyPenaltySetting" AutomationProperties.Name="频率惩罚" Minimum="0" Maximum="2" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 0（关闭）。复读严重时可试 0.3～0.5，过高易词串散乱" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="存在惩罚" Description="默认 0。">
                                        <NumberBox x:Name="PresencePenaltyBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="PresencePenaltySetting" AutomationProperties.Name="存在惩罚" Minimum="0" Maximum="2" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 0（关闭）" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="重复惩罚" Description="默认 1.0。复读时可试 1.08～1.15。">
                                        <NumberBox x:Name="RepeatPenaltyBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="RepeatPenaltySetting" AutomationProperties.Name="重复惩罚" Minimum="1" Maximum="2" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 1.0（关闭）。复读时可试 1.08～1.15" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="DRY 抗重复" Description="默认 0。长程复读时可试 0.8～1.2。">
                                        <NumberBox x:Name="DryMultiplierBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="DryMultiplierSetting" AutomationProperties.Name="DRY 抗重复" Minimum="0" Maximum="5" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 0（关闭）。长程复读时可试 0.8～1.2" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="重复检测窗口" Description="默认 64。开启重复惩罚时才有意义。">
                                        <NumberBox x:Name="RepeatLastNBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="RepeatLastNSetting" AutomationProperties.Name="重复检测窗口" Minimum="0" Maximum="2048" SmallChange="32" LargeChange="128" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="默认 64。开启重复惩罚时才有意义" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="输出去重裁尾" Description="默认关闭。误判会让长文变短。">
                                        <ToggleSwitch x:Name="ClientRepetitionGuardToggle" AutomationProperties.AutomationId="ClientRepetitionGuardSetting" AutomationProperties.Name="输出去重裁尾" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="默认关闭。开启后客户端会裁段落/口号复读，并可能提前停流；误判会让长文变短变乱" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="按目标字数收紧输出" Description="识别「约4000字」等提示。默认关闭。">
                                        <ToggleSwitch x:Name="AutoTightenOutputToggle" AutomationProperties.AutomationId="AutoTightenOutputSetting" AutomationProperties.Name="按目标字数收紧输出" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="识别「约4000字」等提示，把本轮 max_tokens 收到接近目标；默认关闭" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="长文分段写作" Description="约 ≥2000 字时拆成多段。默认关闭。">
                                        <ToggleSwitch x:Name="SegmentedLongFormToggle" AutomationProperties.AutomationId="SegmentedLongFormSetting" AutomationProperties.Name="长文分段写作" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="约≥2000字时拆成多段；默认关闭" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>

                            <TextBlock Text="会话" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <toolkit:SettingsCard Header="列表排序" Description="即时生效，无需重启模型。">
                                <ComboBox x:Name="SessionSortModeBox" AutomationProperties.AutomationId="SessionSortModeSetting" AutomationProperties.Name="列表排序" MinWidth="220" SelectedIndex="0" ToolTipService.ToolTip="创建时间：新建在上且聊天时不跳位；最近更新：刚聊过的会话排到最前">
                                    <ComboBoxItem Content="按创建时间（新会话在上）" Tag="created" />
                                    <ComboBoxItem Content="按最近更新（刚聊过的在上）" Tag="updated" />
                                </ComboBox>
                            </toolkit:SettingsCard>

                            <TextBlock Text="上下文与记忆" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock Text="窗口和 GPU 相关需重启；轮数与召回即时。" Style="{StaticResource SettingsSectionHintStyle}" Margin="1,0,0,2" />
                            <toolkit:SettingsCard Header="上下文窗口" Description="修改后需重启模型。">
                                <NumberBox x:Name="ContextSizeBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="ContextSizeSetting" AutomationProperties.Name="上下文窗口" Minimum="2048" Maximum="32768" SmallChange="1024" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="模型服务的上下文容量，修改后需重启模型" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="历史轮数" Description="参与上下文的最近完整问答轮数。默认 40。">
                                <NumberBox x:Name="MaxHistoryRoundsBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="MaxHistoryRoundsSetting" AutomationProperties.Name="历史轮数" Minimum="1" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="参与上下文的最近完整问答轮数；默认 40" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="MemOS 召回">
                                <NumberBox x:Name="MemosTopKBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="MemosTopKSetting" AutomationProperties.Name="MemOS 召回" Minimum="1" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="主窗口开关" Description="请在主窗口底部切换；此处仅作状态对照。" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MemosStatusReadonlyText" AutomationProperties.AutomationId="MemosStatusReadonlyText" Text="MemOS 长期记忆：关闭" Style="{StaticResource SettingsSectionHintStyle}" />
                                    <TextBlock x:Name="LogStatusReadonlyText" AutomationProperties.AutomationId="LogStatusReadonlyText" Text="聊天日志：关闭" Style="{StaticResource SettingsSectionHintStyle}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <TextBlock Text="模型启动" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock Text="需停止模型后重开。并发大于 1 时用共享上下文池。" Style="{StaticResource SettingsSectionHintStyle}" Margin="1,0,0,2" TextWrapping="Wrap" />
                            <toolkit:SettingsCard Header="GPU 层">
                                <NumberBox x:Name="GpuLayersBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="GpuLayersSetting" AutomationProperties.Name="GPU 层" Minimum="0" Maximum="999" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="并发槽位" Description="多路同时生成时才共享同一上下文池。">
                                <NumberBox x:Name="ParallelSlotsBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="ParallelSlotsSetting" AutomationProperties.Name="并发槽位" Minimum="1" Maximum="8" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ToolTipService.ToolTip="可同时生成的会话数。启用共享 KV：平时只跑一路时尽量用满「上下文窗口」；多路同时生成时才共享同一池，无需为并发永久切短单路窗口。" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="启动等待（秒）">
                                <NumberBox x:Name="StartupTimeoutBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="StartupTimeoutSetting" AutomationProperties.Name="启动等待（秒）" Minimum="30" Maximum="600" SmallChange="30" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="思考模式" Description="修改后需重启模型。">
                                <ToggleSwitch x:Name="ReasoningToggle" AutomationProperties.AutomationId="ReasoningSetting" AutomationProperties.Name="思考模式" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="控制模型服务的思考模式，修改后需重启模型" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="Jinja 模板" Description="用模型自带对话模板，建议保持开启。">
                                <ToggleSwitch x:Name="JinjaToggle" AutomationProperties.AutomationId="JinjaSetting" AutomationProperties.Name="Jinja 模板" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="用模型自带对话模板，建议保持开启" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="模型别名">
                                <TextBox x:Name="ModelAliasBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="ModelAliasSetting" AutomationProperties.Name="模型别名" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="模型文件" Description="绝对路径或相对项目根。">
                                <TextBox x:Name="ModelPathBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="ModelPathSetting" AutomationProperties.Name="模型文件" TextWrapping="Wrap" />
                            </toolkit:SettingsCard>

                            <TextBlock Text="本地服务" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <toolkit:SettingsCard Header="端口" Description="变更后需重启模型。">
                                <NumberBox x:Name="PortBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="PortSetting" AutomationProperties.Name="端口" Minimum="1024" Maximum="65535" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="固定安全边界" Description="服务监听 127.0.0.1；子进程使用本地模型配置。" />
                            <toolkit:SettingsCard Header="记忆调用按需启动模型" Description="健康检查和列表查询不会启动。">
                                <ToggleSwitch x:Name="AutoStartOnDemandToggle" AutomationProperties.AutomationId="AutoStartOnDemandSetting" AutomationProperties.Name="记忆调用按需启动模型" OnContent="开启" OffContent="关闭" ToolTipService.ToolTip="MemOS 的 recall 和 remember 在服务停止时可启动共享模型；健康检查和列表查询不会启动" />
                            </toolkit:SettingsCard>

                            <TextBlock Text="聊天附件" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock Text="即时。默认最多 4 个文件、单文件 256 KB。当前文本模型只读文本和 PDF 抽出的文字。" Style="{StaticResource SettingsSectionHintStyle}" Margin="1,0,0,2" TextWrapping="Wrap" />
                            <toolkit:SettingsCard Header="文本">
                                <ToggleSwitch x:Name="ChatAttachTextToggle" AutomationProperties.AutomationId="ChatAttachTextSetting" AutomationProperties.Name="文本" OnContent="允许" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="图片">
                                <ToggleSwitch x:Name="ChatAttachImageToggle" AutomationProperties.AutomationId="ChatAttachImageSetting" AutomationProperties.Name="图片" OnContent="允许" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="音频">
                                <ToggleSwitch x:Name="ChatAttachAudioToggle" AutomationProperties.AutomationId="ChatAttachAudioSetting" AutomationProperties.Name="音频" OnContent="允许" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="视频">
                                <ToggleSwitch x:Name="ChatAttachVideoToggle" AutomationProperties.AutomationId="ChatAttachVideoSetting" AutomationProperties.Name="视频" OnContent="允许" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="最多文件数" Description="可调到 9 个。">
                                <NumberBox x:Name="ChatAttachMaxFilesBox" AutomationProperties.AutomationId="ChatAttachMaxFilesSetting" AutomationProperties.Name="最多文件数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="9" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="单文件上限（KB）" Description="可调到 16 MB。">
                                <NumberBox x:Name="ChatAttachMaxKbBox" AutomationProperties.AutomationId="ChatAttachMaxKbSetting" AutomationProperties.Name="单文件上限（KB）" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="4" Maximum="16384" SmallChange="64" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="额外文本扩展名">
                                <TextBox x:Name="ChatAttachExtraExtensionsBox" AutomationProperties.AutomationId="ChatAttachExtraExtensionsSetting" AutomationProperties.Name="额外文本扩展名" PlaceholderText=".rst, .tex" Style="{StaticResource CompactSettingsTextBoxStyle}" />
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel x:Name="VideoSettingsSection" Visibility="Collapsed" Spacing="4">
                            <TextBlock Text="当前视频模型" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <toolkit:SettingsCard Header="模型档案" Description="节点映射和能力范围随模型切换。">
                                <ComboBox x:Name="VideoModelProfileBox" AutomationProperties.AutomationId="VideoModelProfileSetting" AutomationProperties.Name="当前视频模型" MinWidth="220" DisplayMemberPath="DisplayName" SelectionChanged="VideoModelProfileBox_SelectionChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="档案说明" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="首次开始生成时会按需启动；也可先启动检查服务。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VideoModelProfileDetails" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <Border x:Name="VideoSettingsRecordHost" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="VideoModelSettingsCardTitle" Text="此模型的设置记录" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VideoModelSettingsCardSummary" AutomationProperties.AutomationId="VideoModelSettingsCardSummary" Text="分辨率、时长、步数和种子按当前视频档案单独保存。切换档案后，生成默认值换成该档案自己的记录。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="VideoModelOperationStatus" AutomationProperties.AutomationId="VideoModelOperationStatus" Style="{StaticResource SettingsSectionHintStyle}" />
                            <toolkit:SettingsCard Header="模型目录">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="VideoImportButton" MinWidth="120" AutomationProperties.AutomationId="VideoImportButton" AutomationProperties.Name="选择本地视频模型目录" Content="选择本地目录" Click="VideoImportButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ReleaseVideoModelButton" MinWidth="120" AutomationProperties.AutomationId="ReleaseVideoModelButton" AutomationProperties.Name="释放视频模型" Content="释放模型" Click="ReleaseVideoModelButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <Expander x:Name="VideoProfileParametersExpander" AutomationProperties.AutomationId="VideoProfileParametersExpander" Header="模型档案参数（能力范围与工作流）" ExpandDirection="Down" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="4" Margin="0,8,0,4">
                                    <TextBlock Text="默认按档案推荐值填写。保存后提交时覆盖对应节点，不会改写磁盘上的工作流文件。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <toolkit:SettingsCard Header="显示名称">
                                        <TextBox x:Name="VideoProfileDisplayNameBox" AutomationProperties.AutomationId="VideoProfileDisplayNameSetting" AutomationProperties.Name="显示名称" Style="{StaticResource CompactSettingsTextBoxStyle}" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="帧率">
                                        <NumberBox x:Name="VideoProfileFpsBox" AutomationProperties.AutomationId="VideoProfileFpsSetting" AutomationProperties.Name="帧率" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="240" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="帧对齐倍数">
                                        <NumberBox x:Name="VideoProfileAlignmentMultipleBox" AutomationProperties.AutomationId="VideoProfileAlignmentMultipleSetting" AutomationProperties.Name="帧对齐倍数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="10000" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="帧对齐偏移">
                                        <NumberBox x:Name="VideoProfileAlignmentOffsetBox" AutomationProperties.AutomationId="VideoProfileAlignmentOffsetSetting" AutomationProperties.Name="帧对齐偏移" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="9999" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="尺寸步进">
                                        <NumberBox x:Name="VideoProfileDimensionStepBox" AutomationProperties.AutomationId="VideoProfileDimensionStepSetting" AutomationProperties.Name="尺寸步进" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="4096" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最小边长">
                                        <NumberBox x:Name="VideoProfileMinimumDimensionBox" AutomationProperties.AutomationId="VideoProfileMinimumDimensionSetting" AutomationProperties.Name="最小边长" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="64" Maximum="4096" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最大边长">
                                        <NumberBox x:Name="VideoProfileMaximumDimensionBox" AutomationProperties.AutomationId="VideoProfileMaximumDimensionSetting" AutomationProperties.Name="最大边长" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="64" Maximum="4096" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最大像素数">
                                        <NumberBox x:Name="VideoProfileMaximumPixelsBox" AutomationProperties.AutomationId="VideoProfileMaximumPixelsSetting" AutomationProperties.Name="最大像素数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="2147483647" SmallChange="1024" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最短时长（秒）">
                                        <NumberBox x:Name="VideoProfileMinimumDurationBox" AutomationProperties.AutomationId="VideoProfileMinimumDurationSetting" AutomationProperties.Name="最短时长（秒）" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="300" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最长时长（秒）">
                                        <NumberBox x:Name="VideoProfileMaximumDurationBox" AutomationProperties.AutomationId="VideoProfileMaximumDurationSetting" AutomationProperties.Name="最长时长（秒）" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="300" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最少步数">
                                        <NumberBox x:Name="VideoProfileMinimumStepsBox" AutomationProperties.AutomationId="VideoProfileMinimumStepsSetting" AutomationProperties.Name="最少步数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="1000" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最多步数">
                                        <NumberBox x:Name="VideoProfileMaximumStepsBox" AutomationProperties.AutomationId="VideoProfileMaximumStepsSetting" AutomationProperties.Name="最多步数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="1" Maximum="1000" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <TextBlock Text="媒体上限" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,12,0,2" />
                                    <TextBlock Text="默认参考图 4 张、视频和音频各 1。某一类调到 0 只隐藏那一类。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <toolkit:SettingsCard Header="最大参考图张数">
                                        <NumberBox x:Name="VideoProfileMaxReferenceImagesBox" AutomationProperties.AutomationId="VideoProfileMaxReferenceImagesSetting" AutomationProperties.Name="最大参考图张数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="9" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="参考图尺寸">
                                        <ComboBox x:Name="VideoProfileRefImageSizeBox" AutomationProperties.AutomationId="VideoProfileRefImageSizeSetting" AutomationProperties.Name="参考图尺寸" MinWidth="180">
                                            <ComboBoxItem Content="匹配生成分辨率" Tag="match" />
                                            <ComboBoxItem Content="最大短边（更吃显存）" Tag="max" />
                                        </ComboBox>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最大参考视频数">
                                        <NumberBox x:Name="VideoProfileMaxReferenceVideosBox" AutomationProperties.AutomationId="VideoProfileMaxReferenceVideosSetting" AutomationProperties.Name="最大参考视频数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="3" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="最大参考音频数">
                                        <NumberBox x:Name="VideoProfileMaxReferenceAudiosBox" AutomationProperties.AutomationId="VideoProfileMaxReferenceAudiosSetting" AutomationProperties.Name="最大参考音频数" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="3" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="文生视频">
                                        <ToggleSwitch x:Name="VideoProfileTextToVideoToggle" AutomationProperties.AutomationId="VideoProfileTextToVideoSetting" AutomationProperties.Name="文生视频" OnContent="开启" OffContent="关闭" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="首帧图生视频">
                                        <ToggleSwitch x:Name="VideoProfileFirstFrameToggle" AutomationProperties.AutomationId="VideoProfileFirstFrameSetting" AutomationProperties.Name="首帧图生视频" OnContent="开启" OffContent="关闭" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="首帧 + 尾帧 / 尾帧">
                                        <ToggleSwitch x:Name="VideoProfileFirstLastFrameToggle" AutomationProperties.AutomationId="VideoProfileFirstLastFrameSetting" AutomationProperties.Name="首帧 + 尾帧 / 尾帧" OnContent="开启" OffContent="关闭" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="默认模式">
                                        <ComboBox x:Name="VideoProfileDefaultModeBox" AutomationProperties.AutomationId="VideoProfileDefaultModeSetting" AutomationProperties.Name="默认模式" MinWidth="180">
                                            <ComboBoxItem Content="文生视频" Tag="text" />
                                            <ComboBoxItem Content="首帧图生视频" Tag="first_frame" />
                                            <ComboBoxItem Content="首帧 + 尾帧" Tag="first_last_frame" />
                                            <ComboBoxItem Content="尾帧图生视频" Tag="last_frame" />
                                            <ComboBoxItem Content="参考图" Tag="single_reference_image" />
                                            <ComboBoxItem Content="参考视频" Tag="reference_video" />
                                            <ComboBoxItem Content="参考音频" Tag="reference_audio" />
                                        </ComboBox>
                                    </toolkit:SettingsCard>
                                    <TextBlock Text="工作流参数" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,12,0,2" />
                                    <TextBlock Text="这些值以前写死在工作流模板里。改完后下次提交会写到对应节点。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <toolkit:SettingsCard Header="CFG">
                                        <NumberBox x:Name="VideoProfileCfgBox" AutomationProperties.AutomationId="VideoProfileCfgSetting" AutomationProperties.Name="CFG" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="100" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="去噪">
                                        <NumberBox x:Name="VideoProfileDenoiseBox" AutomationProperties.AutomationId="VideoProfileDenoiseSetting" AutomationProperties.Name="去噪" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="采样器">
                                        <ComboBox x:Name="VideoProfileSamplerBox" AutomationProperties.AutomationId="VideoProfileSamplerSetting" AutomationProperties.Name="采样器" MinWidth="180">
                                            <ComboBoxItem Content="euler" Tag="euler" />
                                            <ComboBoxItem Content="euler_ancestral" Tag="euler_ancestral" />
                                            <ComboBoxItem Content="dpmpp_2m" Tag="dpmpp_2m" />
                                            <ComboBoxItem Content="dpmpp_2m_sde" Tag="dpmpp_2m_sde" />
                                            <ComboBoxItem Content="dpmpp_sde" Tag="dpmpp_sde" />
                                            <ComboBoxItem Content="uni_pc" Tag="uni_pc" />
                                            <ComboBoxItem Content="ddim" Tag="ddim" />
                                            <ComboBoxItem Content="lcm" Tag="lcm" />
                                        </ComboBox>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="调度器">
                                        <ComboBox x:Name="VideoProfileSchedulerBox" AutomationProperties.AutomationId="VideoProfileSchedulerSetting" AutomationProperties.Name="调度器" MinWidth="180">
                                            <ComboBoxItem Content="simple" Tag="simple" />
                                            <ComboBoxItem Content="normal" Tag="normal" />
                                            <ComboBoxItem Content="karras" Tag="karras" />
                                            <ComboBoxItem Content="exponential" Tag="exponential" />
                                            <ComboBoxItem Content="sgm_uniform" Tag="sgm_uniform" />
                                            <ComboBoxItem Content="ddim_uniform" Tag="ddim_uniform" />
                                            <ComboBoxItem Content="beta" Tag="beta" />
                                        </ComboBox>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="视频 shift">
                                        <NumberBox x:Name="VideoProfileShiftVideoBox" AutomationProperties.AutomationId="VideoProfileShiftVideoSetting" AutomationProperties.Name="视频 shift" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0.01" Maximum="100" SmallChange="0.5" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="音频 shift">
                                        <NumberBox x:Name="VideoProfileShiftAudioBox" AutomationProperties.AutomationId="VideoProfileShiftAudioSetting" AutomationProperties.Name="音频 shift" Style="{StaticResource CompactSettingsNumberBoxStyle}" Minimum="0.01" Maximum="100" SmallChange="0.5" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="负面提示词">
                                        <TextBox x:Name="VideoProfileNegativePromptBox" AutomationProperties.AutomationId="VideoProfileNegativePromptSetting" AutomationProperties.Name="负面提示词" Style="{StaticResource CompactSettingsTextBoxStyle}" />
                                    </toolkit:SettingsCard>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="VideoPromptPhrasesExpander" AutomationProperties.AutomationId="VideoPromptPhrasesExpander" Header="提示词模板" ExpandDirection="Down" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel Spacing="8" Margin="0,8,0,4">
                                    <TextBlock Text="生成页四个格子的名字。日常改提示词请在视频页填四格，或点「查看正文」。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                    <StackPanel x:Name="VideoPromptPrefixHost" Spacing="8" />
                                    <Expander Header="高级套话（一般不用改）" ExpandDirection="Down" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="插入模板时的官方骨架句子。占位符：{id} {pic} {vid} {clauses}。留空则用默认。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                                            <StackPanel x:Name="VideoPromptPhraseHost" Spacing="8" />
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="ResetVideoPromptPhrasesButton" AutomationProperties.AutomationId="ResetVideoPromptPhrasesButton" AutomationProperties.Name="恢复模板套话为官方默认" Content="恢复官方套话" MinWidth="120" HorizontalAlignment="Right" Click="ResetVideoPromptPhrasesButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Expander>

                            <TextBlock Text="生成默认值" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock x:Name="VideoCapabilityHint" Text="保存后用于下一次视频生成；具体范围由当前模型档案决定。" Style="{StaticResource SettingsSectionHintStyle}" TextWrapping="Wrap" />
                            <toolkit:SettingsCard Header="宽度">
                                <NumberBox x:Name="VideoWidthBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="VideoWidthSetting" AutomationProperties.Name="宽度" Minimum="256" Maximum="1024" SmallChange="32" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="高度">
                                <NumberBox x:Name="VideoHeightBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="VideoHeightSetting" AutomationProperties.Name="高度" Minimum="256" Maximum="1024" SmallChange="32" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="时长（秒）">
                                <NumberBox x:Name="VideoDurationBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="VideoDurationSetting" AutomationProperties.Name="时长（秒）" Minimum="5" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="步数">
                                <NumberBox x:Name="VideoStepsBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="VideoStepsSetting" AutomationProperties.Name="步数" Minimum="10" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="固定种子">
                                <NumberBox x:Name="VideoSeedBox" Style="{StaticResource CompactSettingsNumberBoxStyle}" AutomationProperties.AutomationId="VideoSeedSetting" AutomationProperties.Name="固定种子" Minimum="0" Maximum="2147483647" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="随机种子" Description="尺寸、时长、步数和帧率限制由当前模型档案提供。">
                                <ToggleSwitch x:Name="VideoRandomSeedToggle" AutomationProperties.AutomationId="VideoRandomSeedSetting" AutomationProperties.Name="随机种子" OnContent="开启" OffContent="关闭" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="输出格式">
                                <ComboBox x:Name="VideoOutputFormatBox" AutomationProperties.AutomationId="VideoOutputFormatSetting" AutomationProperties.Name="输出格式" MinWidth="140">
                                    <ComboBoxItem Content="MP4" Tag="mp4" />
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="视频编码">
                                <ComboBox x:Name="VideoCodecBox" AutomationProperties.AutomationId="VideoCodecSetting" AutomationProperties.Name="视频编码" MinWidth="140">
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                    <ComboBoxItem Content="H.264" Tag="h264" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel x:Name="HanhuaSettingsSection" Visibility="Collapsed" Spacing="4">
                            <TextBlock Text="汉化路径" Style="{StaticResource SettingsSectionTitleStyle}" Margin="1,22,0,2" />
                            <TextBlock Text="即时。密钥留在云端 JSON 里，不要填到这里。" Style="{StaticResource SettingsSectionHintStyle}" Margin="1,0,0,2" TextWrapping="Wrap" />
                            <toolkit:SettingsCard Header="汉化工具包根目录">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="HanhuaPackRootBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="HanhuaPackRootSetting" AutomationProperties.Name="汉化工具包根目录" PlaceholderText="选择内嵌汉化工具包目录" TextWrapping="Wrap" />
                                    <Button x:Name="HanhuaPackRootPickButton" MinWidth="96" AutomationProperties.AutomationId="HanhuaPackRootPickButton" AutomationProperties.Name="浏览汉化工具包目录" Content="浏览" Click="HanhuaPackRootPickButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="Python 可执行文件">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="HanhuaPythonExeBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="HanhuaPythonExeSetting" AutomationProperties.Name="Python 可执行文件" PlaceholderText="选择 python.exe" TextWrapping="Wrap" />
                                    <Button x:Name="HanhuaPythonExePickButton" MinWidth="96" AutomationProperties.AutomationId="HanhuaPythonExePickButton" AutomationProperties.Name="浏览 Python 可执行文件" Content="浏览" Click="HanhuaPythonExePickButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="manga-image-translator 根目录">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="HanhuaMitRootBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="HanhuaMitRootSetting" AutomationProperties.Name="manga-image-translator 根目录" PlaceholderText="选择 MIT 目录" TextWrapping="Wrap" />
                                    <Button x:Name="HanhuaMitRootPickButton" MinWidth="96" AutomationProperties.AutomationId="HanhuaMitRootPickButton" AutomationProperties.Name="浏览 MIT 目录" Content="浏览" Click="HanhuaMitRootPickButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="填字模型档案" Description="改档案和 GGUF 不影响聊天默认档案。">
                                <ComboBox x:Name="HanhuaFillProfileBox" AutomationProperties.AutomationId="HanhuaFillProfileSetting" AutomationProperties.Name="汉化填字模型" MinWidth="220" DisplayMemberPath="DisplayName" SelectionChanged="HanhuaFillProfileBox_SelectionChanged" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="填字模型文件">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="HanhuaFillModelPathBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="HanhuaFillModelPathSetting" AutomationProperties.Name="填字模型文件" PlaceholderText="选择填字 GGUF" TextWrapping="Wrap" />
                                    <Button x:Name="HanhuaFillModelPickButton" MinWidth="96" AutomationProperties.AutomationId="HanhuaFillModelPickButton" AutomationProperties.Name="浏览填字模型文件" Content="浏览" Click="HanhuaFillModelPickButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="云端配置文件" Description="换线路就换文件。">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="HanhuaCloudConfigBox" Style="{StaticResource CompactSettingsTextBoxStyle}" AutomationProperties.AutomationId="HanhuaCloudConfigSetting" AutomationProperties.Name="云端配置文件" PlaceholderText="选择含 baseUrl / model 的 JSON" TextWrapping="Wrap" />
                                    <Button x:Name="HanhuaCloudConfigPickButton" MinWidth="96" AutomationProperties.AutomationId="HanhuaCloudConfigPickButton" AutomationProperties.Name="浏览云端配置文件" Content="浏览" Click="HanhuaCloudConfigPickButton_Click" Style="{StaticResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <InfoBar x:Name="ValidationInfo" AutomationProperties.AutomationId="SettingsValidationInfo" IsOpen="False" IsClosable="False" Severity="Error" />

                        <Grid MinHeight="44">
                            <Grid x:Name="FooterActionsBar">
                                <toolkit:SettingsCard Header="写入设置" Description="恢复默认值只重填表单，要再点保存才写入。">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button MinWidth="120" AutomationProperties.AutomationId="ResetSettingsButton" AutomationProperties.Name="恢复默认值" Content="恢复默认值" Click="ResetButton_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="仅重填表单默认值，需再点保存才会写入" />
                                        <Button MinWidth="120" AutomationProperties.AutomationId="SaveSettingsButton" AutomationProperties.Name="保存设置" Content="保存" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </Grid>
                            <Border x:Name="DiscardConfirmBar" AutomationProperties.AutomationId="SettingsDiscardConfirmBar" Height="0" Opacity="0" IsHitTestVisible="False" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid ColumnSpacing="8" Margin="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="有未保存的修改，关闭将丢弃本次改动。" FontFamily="Microsoft YaHei UI" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Button x:Name="KeepEditingButton" Grid.Column="1" AutomationProperties.AutomationId="KeepEditingSettingsButton" AutomationProperties.Name="继续编辑设置" Content="继续编辑" Click="KeepEditingButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="96" IsEnabled="False" />
                                    <Button x:Name="DiscardAndCloseButton" Grid.Column="2" AutomationProperties.AutomationId="DiscardSettingsButton" AutomationProperties.Name="放弃并关闭设置" Content="放弃并关闭" Click="DiscardAndCloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" IsEnabled="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
