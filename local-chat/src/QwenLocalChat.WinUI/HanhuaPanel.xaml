<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QwenLocalChat_WinUI.HanhuaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="任务日志" Style="{StaticResource ComposerTitleTextStyle}" Margin="4,0,4,8" />
                    <Grid Grid.Row="1">
                        <ListView x:Name="JobLogList" AutomationProperties.AutomationId="HanhuaJobLog" AutomationProperties.Name="汉化任务日志" SelectionMode="None" IsTabStop="False" Padding="8" Background="Transparent" BorderBrush="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <Image x:Name="ResultPreview" AutomationProperties.AutomationId="HanhuaResultPreview" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="220" MaxHeight="160" Margin="12" />
                        <StackPanel x:Name="HanhuaEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420">
                            <TextBlock
                                x:Name="HanhuaEmptyStateHint"
                                Text="选 RPG Maker（Game.exe）或 Unity 游戏目录，点开始汉化即可。不用点右上角启动。"
                                Style="{StaticResource StatusTextStyle}"
                                TextWrapping="Wrap"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="HanhuaComposerHost" Grid.Row="1" Margin="0,10,0,10" Padding="14,12,12,10" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="18">
            <Grid RowSpacing="6" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="汉化任务" Style="{StaticResource ComposerTitleTextStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="KindBox"
                        AutomationProperties.AutomationId="HanhuaKind"
                        AutomationProperties.Name="汉化种类"
                        MinWidth="112"
                        SelectionChanged="KindBox_SelectionChanged">
                        <ComboBoxItem Content="游戏文本" Tag="game" />
                        <ComboBoxItem Content="漫画图片" Tag="image" />
                    </ComboBox>
                    <ComboBox
                        x:Name="EngineBox"
                        AutomationProperties.AutomationId="HanhuaEngine"
                        AutomationProperties.Name="汉化引擎"
                        MinWidth="112"
                        SelectionChanged="EngineBox_SelectionChanged"
                        ToolTipService.ToolTip="本机走设置里的填字模型。云端走设置里的配置文件，密钥不进 Local AI。">
                        <ComboBoxItem Content="本机" Tag="local" />
                        <ComboBoxItem Content="云端" Tag="aliyun" />
                    </ComboBox>
                </StackPanel>

                <TextBox x:Name="SourcePathBox" Grid.Row="1" Grid.Column="0" AutomationProperties.AutomationId="HanhuaSourcePath" AutomationProperties.Name="汉化源目录" IsReadOnly="True" PlaceholderText="选择游戏或图片目录" Style="{StaticResource ComposerInputTextBoxStyle}" MinHeight="40" MaxHeight="40" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="PickFolderButton" AutomationProperties.AutomationId="HanhuaPickFolderButton" AutomationProperties.Name="选择目录" Content="选择目录" Click="PickFolderButton_Click" Style="{StaticResource ComposerSecondaryButtonStyle}" />
                    <Button x:Name="ComposerStartButton" AutomationProperties.AutomationId="HanhuaComposerStartButton" AutomationProperties.Name="开始汉化" Content="开始汉化" Click="StartOrCancel_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <Border x:Name="DuplicateConfirmBar" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0" Padding="10,8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DuplicateConfirmText" Text="这个目录已经汉化过。接着上次只补未译对白和缺页；全新会整本重抽。" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="DuplicateContinueButton" AutomationProperties.AutomationId="HanhuaDuplicateContinueButton" AutomationProperties.Name="接着上次汉化" Content="接着上次" Click="DuplicateContinueButton_Click" Style="{StaticResource VideoPrimaryButtonStyle}" MinWidth="96" />
                            <Button x:Name="DuplicateFreshButton" AutomationProperties.AutomationId="HanhuaDuplicateFreshButton" AutomationProperties.Name="全新汉化" Content="全新" Click="DuplicateFreshButton_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="72" />
                            <Button x:Name="DuplicateCancelButton" AutomationProperties.AutomationId="HanhuaDuplicateCancelButton" AutomationProperties.Name="取消重复汉化" Content="取消" Click="DuplicateCancelButton_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="72" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="HanhuaComposerHint" Grid.Row="3" Grid.ColumnSpan="2" Text="RPG Maker：复制 → 抽字 → 翻译 → 回写。Unity：装插件 → 预填已抽出的句子。本机模型会自动启动。" Style="{StaticResource ComposerHintTextStyle}" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <Border x:Name="HanhuaCommandSurface" Grid.Row="2" Style="{StaticResource CommandSurfaceStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox x:Name="HanhuaStatusBox" AutomationProperties.AutomationId="HanhuaJobStatus" AutomationProperties.Name="汉化任务状态" Text="等待开始" IsReadOnly="True" TextWrapping="NoWrap" Style="{StaticResource CommandStatusTextBoxStyle}" />
                    <ProgressBar x:Name="HanhuaJobProgress" AutomationProperties.AutomationId="HanhuaJobProgress" IsIndeterminate="False" Style="{StaticResource CommandProgressBarStyle}" Visibility="Collapsed" />
                    <TextBlock x:Name="HanhuaJobPercentText" AutomationProperties.AutomationId="HanhuaJobPercentText" AutomationProperties.Name="汉化进度百分比" Text="0%" Visibility="Collapsed" Style="{StaticResource ComposerMetaTextStyle}" VerticalAlignment="Center" />
                    <Button x:Name="HanhuaErrorDetailsButton" AutomationProperties.AutomationId="HanhuaErrorDetailsButton" AutomationProperties.Name="查看完整汉化错误" Content="查看详情" Click="ErrorDetailsButton_Click" Visibility="Collapsed" VerticalAlignment="Center" Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="HanhuaSettingsButton" AutomationProperties.AutomationId="HanhuaSettingsButton" AutomationProperties.Name="模型设置" Content="设置" Click="SettingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="OpenHanhuaOutputButton" AutomationProperties.AutomationId="OpenHanhuaOutputButton" AutomationProperties.Name="打开汉化结果" Content="打开结果" Click="OpenOutputButton_Click" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="CatchUpHanhuaButton" AutomationProperties.AutomationId="HanhuaCatchUpButton" AutomationProperties.Name="补翻译" Content="补翻译" Click="CatchUpButton_Click" Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="漫画只补未译对白和缺页；Unity 收 unmatched 再填，不重装插件。" />
                    <Button x:Name="CancelHanhuaButton" AutomationProperties.AutomationId="CancelHanhuaButton" AutomationProperties.Name="取消汉化" Content="取消" Click="StartOrCancel_Click" Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
