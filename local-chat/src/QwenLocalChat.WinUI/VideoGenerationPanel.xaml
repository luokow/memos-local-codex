<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QwenLocalChat_WinUI.VideoGenerationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QwenLocalChat_WinUI">
    <UserControl.Resources>
        <Style x:Key="ReferenceWrapHostStyle" TargetType="ItemsControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:ChipWrapPanel HorizontalSpacing="10" VerticalSpacing="4" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid x:Name="VideoPreviewRegion" Grid.Row="0" SizeChanged="VideoPreviewRegion_SizeChanged">
            <Border x:Name="VideoPreviewFrame" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <MediaPlayerElement x:Name="VideoPreview" AutomationProperties.AutomationId="VideoPreview" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" PointerEntered="VideoPreview_PointerEntered" PointerExited="VideoPreview_PointerExited" GotFocus="VideoPreview_GotFocus" LostFocus="VideoPreview_LostFocus">
                    <MediaPlayerElement.TransportControls>
                        <MediaTransportControls IsCompact="True" />
                    </MediaPlayerElement.TransportControls>
                </MediaPlayerElement>
            </Border>
            <TextBlock x:Name="VideoEmptyState" Text="生成完成后在这里预览视频" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Composer rhythm matches chat: title+meta | input | optional strip | params | hints. -->
        <Border Grid.Row="1" Margin="0,10,0,10" Padding="14,12,12,10" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="18">
            <Grid RowSpacing="6" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="VideoPromptLabel" Text="视频提示词" Style="{StaticResource ComposerTitleTextStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="VideoConditioningModeBox"
                        AutomationProperties.AutomationId="VideoConditioningMode"
                        AutomationProperties.Name="视频生成模式"
                        MinWidth="128"
                        MaxWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="VideoConditioningModeBox_SelectionChanged"
                        ToolTipService.ToolTip="文生 / 首帧 / 首尾帧 / 尾帧 / 参考图 / 参考视频 / 参考音频。数量上限在设置里调整。" />
                    <Button x:Name="ExpandVideoInputButton" AutomationProperties.AutomationId="ExpandVideoInputButton" AutomationProperties.Name="展开视频提示词" Content="展开" Click="ExpandVideoInputButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="VideoPromptInput" AutomationProperties.AutomationId="VideoPromptInput" AutomationProperties.Name="视频提示词" MinHeight="78" MaxHeight="188" Style="{StaticResource ComposerInputTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="描述画面、动作、镜头和环境声音" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="VideoPromptInput_PreviewKeyDown" />
                    <Grid x:Name="PromptSlotsHost" Visibility="Collapsed" RowSpacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExtraIdentityLabel" Text="身份" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox x:Name="ExtraIdentityBox" Grid.Column="1" AutomationProperties.AutomationId="ExtraIdentityBox" AutomationProperties.Name="身份" PlaceholderText="锁脸、服装，可空" MinHeight="32" MaxHeight="88" Style="{StaticResource ComposerInputTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="PromptSlot_TextChanged" SelectionChanged="VideoPromptInput_SelectionChanged" PreviewKeyDown="VideoPromptInput_PreviewKeyDown" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExtraActionLabel" Text="镜头" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox x:Name="ExtraActionBox" Grid.Column="1" AutomationProperties.AutomationId="ExtraActionBox" AutomationProperties.Name="镜头" PlaceholderText="运镜、动作、表情" MinHeight="52" Style="{StaticResource ComposerInputTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextChanged="PromptSlot_TextChanged" SelectionChanged="VideoPromptInput_SelectionChanged" PreviewKeyDown="VideoPromptInput_PreviewKeyDown" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExtraSoundLabel" Text="声音" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox x:Name="ExtraSoundBox" Grid.Column="1" AutomationProperties.AutomationId="ExtraSoundBox" AutomationProperties.Name="声音" PlaceholderText="可空" MinHeight="32" MaxHeight="88" Style="{StaticResource ComposerInputTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="PromptSlot_TextChanged" PreviewKeyDown="VideoPromptInput_PreviewKeyDown" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExtraMusicLabel" Text="配乐" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox x:Name="ExtraMusicBox" Grid.Column="1" AutomationProperties.AutomationId="ExtraMusicBox" AutomationProperties.Name="配乐" PlaceholderText="可空" MinHeight="32" MaxHeight="88" Style="{StaticResource ComposerInputTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="PromptSlot_TextChanged" PreviewKeyDown="VideoPromptInput_PreviewKeyDown" />
                        </Grid>
                        <TextBlock x:Name="AssembledOverrideHint" Grid.Row="4" Style="{StaticResource ComposerHintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Text="正文已手动改过。再改四格会按四格重新组装。" />
                    </Grid>
                    <ListView
                        x:Name="VideoMentionList"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="VideoMentionList"
                        AutomationProperties.Name="插入参考标签"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="VideoMentionList_ItemClick"
                        MaxHeight="132"
                        MinHeight="0"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource StrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Microsoft YaHei UI" FontSize="13" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Only expands when an image mode is selected; text mode stays chat-height. -->
                <Border x:Name="VideoMediaCard" Grid.Row="2" Grid.ColumnSpan="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,0" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <Grid x:Name="VideoMediaSlots" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="FirstFrameSlot" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="FirstFrameThumbHost" Width="36" Height="36" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Image x:Name="FirstFrameThumb" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="首帧" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" Width="32" />
                                <TextBlock x:Name="FirstFramePathText" AutomationProperties.AutomationId="FirstFramePathText" Text="未选择" Style="{StaticResource ComposerMetaTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" MinWidth="64" />
                                <Button x:Name="PickFirstFrameButton" AutomationProperties.AutomationId="PickFirstFrameButton" Content="选择" Click="PickFirstFrameButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button x:Name="ClearFirstFrameButton" AutomationProperties.AutomationId="ClearFirstFrameButton" Content="清除" Click="ClearFirstFrameButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="LastFrameSlot" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="LastFrameThumbHost" Width="36" Height="36" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Image x:Name="LastFrameThumb" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="尾帧" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" Width="32" />
                                <TextBlock x:Name="LastFramePathText" AutomationProperties.AutomationId="LastFramePathText" Text="未选择" Style="{StaticResource ComposerMetaTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" MinWidth="64" />
                                <Button x:Name="PickLastFrameButton" AutomationProperties.AutomationId="PickLastFrameButton" Content="选择" Click="PickLastFrameButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button x:Name="ClearLastFrameButton" AutomationProperties.AutomationId="ClearLastFrameButton" Content="清除" Click="ClearLastFrameButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl
                            x:Name="ReferenceMediaHost"
                            Style="{StaticResource ReferenceWrapHostStyle}"
                            Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            x:Name="VideoPromptTagHintText"
                            AutomationProperties.AutomationId="VideoPromptTagHint"
                            Style="{StaticResource ComposerHintTextStyle}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="InsertVideoPromptTemplateButton"
                            AutomationProperties.AutomationId="InsertVideoPromptTemplateButton"
                            AutomationProperties.Name="插入提示词模板"
                            Content="插入模板"
                            Click="InsertVideoPromptTemplateButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="AppliedTemplateText"
                            AutomationProperties.AutomationId="AppliedTemplateText"
                            Style="{StaticResource ComposerHintTextStyle}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ClearAppliedTemplateButton"
                            AutomationProperties.AutomationId="ClearAppliedTemplateButton"
                            AutomationProperties.Name="清除已套模板"
                            Content="清除模板"
                            Click="ClearAppliedTemplateButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                        </StackPanel>
                        <local:VideoPromptTemplatePicker
                            x:Name="VideoTemplatePicker"
                            Visibility="Collapsed"
                            InsertRequested="VideoTemplatePicker_InsertRequested"
                            Cancelled="VideoTemplatePicker_Cancelled" />
                    </StackPanel>
                </Border>

                <Border x:Name="VideoJobParametersCard" Grid.Row="3" Grid.ColumnSpan="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button
                            x:Name="VideoJobParametersToggle"
                            AutomationProperties.AutomationId="VideoJobParametersExpander"
                            AutomationProperties.Name="展开本次生成参数"
                            MinHeight="32"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="VideoJobParametersToggle_Click"
                            Template="{StaticResource StableButtonTemplate}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="生成参数" Style="{StaticResource ComposerTitleTextStyle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="VideoPresetText" AutomationProperties.AutomationId="VideoPresetText" Style="{StaticResource ComposerMetaTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VideoDurationSummaryText" AutomationProperties.AutomationId="VideoDurationSummaryText" Style="{StaticResource ComposerMetaTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <FontIcon x:Name="VideoJobParametersChevron" Grid.Column="2" Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Border x:Name="VideoJobParametersDetails" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <NumberBox x:Name="VideoJobWidthBox" AutomationProperties.AutomationId="VideoJobWidthSetting" Header="宽度" Style="{StaticResource ComposerParameterNumberBoxStyle}" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="VideoJobParameter_ValueChanged" />
                            <NumberBox x:Name="VideoJobHeightBox" Grid.Column="1" AutomationProperties.AutomationId="VideoJobHeightSetting" Header="高度" Style="{StaticResource ComposerParameterNumberBoxStyle}" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="VideoJobParameter_ValueChanged" />
                            <NumberBox x:Name="VideoJobDurationBox" Grid.Column="2" AutomationProperties.AutomationId="VideoJobDurationSetting" Header="时长（秒）" Style="{StaticResource ComposerParameterNumberBoxStyle}" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="VideoJobParameter_ValueChanged" />
                            <NumberBox x:Name="VideoJobStepsBox" Grid.Row="1" AutomationProperties.AutomationId="VideoJobStepsSetting" Header="步数" Style="{StaticResource ComposerParameterNumberBoxStyle}" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="VideoJobParameter_ValueChanged" />
                            <NumberBox x:Name="VideoJobSeedBox" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="VideoJobSeedSetting" Header="固定种子" Style="{StaticResource ComposerParameterNumberBoxStyle}" Minimum="0" Maximum="2147483647" SmallChange="1" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="VideoJobParameter_ValueChanged" />
                            <ToggleSwitch x:Name="VideoJobRandomSeedToggle" Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="VideoJobRandomSeedSetting" Header="随机种子" OnContent="开启" OffContent="关闭" Toggled="VideoJobRandomSeedToggle_Toggled" />
                            <Button x:Name="ResetVideoJobParametersButton" Grid.Row="2" Grid.ColumnSpan="3" AutomationProperties.AutomationId="ResetVideoJobParametersButton" AutomationProperties.Name="恢复本次参数为全局默认值" Content="恢复默认值" HorizontalAlignment="Right" Click="ResetVideoJobParametersButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="22" Margin="4,0,0,0">
                    <TextBlock Text="Enter 生成" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="Shift+Enter 换行" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="↑↓ 历史" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="展开编辑长提示词" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VideoMentionHintText" Text="输入 @ 插入参考标签；插入模板后在前缀后填写，提交时并进对应字段" Style="{StaticResource ComposerHintTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="VideoCommandSurface" Grid.Row="2" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox x:Name="VideoJobStatus" AutomationProperties.AutomationId="VideoJobStatus" AutomationProperties.Name="视频任务状态" Text="等待开始" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="False" MinHeight="0" MaxHeight="22" Padding="0" Margin="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <ProgressBar x:Name="VideoJobProgress" Width="120" Height="6" MinHeight="6" AutomationProperties.AutomationId="VideoJobProgress" IsIndeterminate="False" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="VideoJobPercentText" AutomationProperties.AutomationId="VideoJobPercentText" AutomationProperties.Name="视频生成百分比" Text="0%" Visibility="Collapsed" Style="{StaticResource ComposerMetaTextStyle}" VerticalAlignment="Center" />
                    <Button x:Name="VideoErrorDetailsButton" AutomationProperties.AutomationId="VideoErrorDetailsButton" AutomationProperties.Name="查看完整视频错误" Content="查看详情" Click="VideoErrorDetailsButton_Click" Visibility="Collapsed" VerticalAlignment="Center" Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="VideoSettingsButton" AutomationProperties.AutomationId="VideoSettingsButton" AutomationProperties.Name="模型设置" Content="设置" Click="VideoSettingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="VideoMoreButton" AutomationProperties.AutomationId="VideoMoreButton" AutomationProperties.Name="更多操作" Content="更多" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="清空当前窗口">
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem AutomationProperties.AutomationId="ClearVideoSessionButton" Text="清空当前会话" Click="ClearVideoSessionButton_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="OpenVideoOutputButton" AutomationProperties.AutomationId="OpenVideoOutputButton" AutomationProperties.Name="打开视频文件位置" Content="文件位置" Click="OpenVideoOutputButton_Click" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="ResumeVideoButton" AutomationProperties.AutomationId="ResumeVideoButton" AutomationProperties.Name="继续上次视频任务" Content="继续上次" Click="ResumeVideoButton_Click" Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="RetryVideoButton" AutomationProperties.AutomationId="RetryVideoButton" AutomationProperties.Name="失败后重试视频生成" Content="重试" Click="RetryVideoButton_Click" Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="CancelVideoButton" AutomationProperties.AutomationId="CancelVideoButton" AutomationProperties.Name="取消视频生成" Content="取消" Click="CancelVideoButton_Click" IsEnabled="False" Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="StartVideoButton" AutomationProperties.AutomationId="StartVideoButton" AutomationProperties.Name="生成视频" Content="生成视频" Click="StartVideoButton_Click" Style="{StaticResource VideoPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
