<UserControl
    x:Class="QwenLocalChat_WinUI.VideoPromptTemplatePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
        <StackPanel Spacing="8">
            <ComboBox
                x:Name="TemplateKindBox"
                AutomationProperties.AutomationId="VideoTemplateKindBox"
                Header="模板"
                HorizontalAlignment="Stretch"
                SelectionChanged="TemplateKindBox_SelectionChanged" />
            <TextBlock x:Name="TemplateDescriptionText" Style="{StaticResource ComposerHintTextStyle}" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TemplateSlotsHost" Spacing="6" />
            </ScrollViewer>
            <TextBlock x:Name="TemplateErrorText" Style="{StaticResource ComposerHintTextStyle}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="插入模板" Click="InsertButton_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.AutomationId="ConfirmVideoTemplateButton" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
