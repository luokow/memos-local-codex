<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QwenLocalChat_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QwenLocalChat_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The approved Mica Quiet background owns one fixed, non-scrolling layer.
            It uses only a neutral base, two soft edge fields, and a nearly invisible
            vertical sheen; the transcript and composer remain independent surfaces.
        -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBackgroundBrush}" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#0B0E13" />
                        <GradientStop Offset="0.54" Color="#0D1117" />
                        <GradientStop Offset="1" Color="#0A0D12" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.94,0.02" GradientOrigin="0.94,0.02" RadiusX="1.1" RadiusY="1.1">
                        <GradientStop Offset="0" Color="#187899C9" />
                        <GradientStop Offset="0.42" Color="#0B334A65" />
                        <GradientStop Offset="1" Color="#00101824" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.04,0.98" GradientOrigin="0.04,0.98" RadiusX="1.12" RadiusY="1.12">
                        <GradientStop Offset="0" Color="#123F5D82" />
                        <GradientStop Offset="0.46" Color="#081F3045" />
                        <GradientStop Offset="1" Color="#00101824" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#0AFFFFFF" />
                        <GradientStop Offset="0.18" Color="Transparent" />
                        <GradientStop Offset="0.82" Color="Transparent" />
                        <GradientStop Offset="1" Color="#06FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid Grid.RowSpan="4" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="132" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- Header: row1 brand+status, row2 session tools, row3 notice -->
            <Grid Grid.Row="0" RowSpacing="8" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" VerticalAlignment="Center" AutomationProperties.AutomationId="AppIconMark" AutomationProperties.Name="Qwen Local 图标">
                            <Image Width="26" Height="26" Source="ms-appx:///Assets/AppIconMark.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Qwen Local" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock x:Name="EndpointText" Text="LOCAL CORE  /  127.0.0.1:18135" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="QwenStatusBorder" CornerRadius="10" Padding="12,7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="QwenStatusText" Text="• 9B 检查中" Style="{StaticResource StatusTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <Border x:Name="MemosStatusBorder" CornerRadius="10" Padding="12,7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="MemosStatusText" Text="○ 记忆关闭" Style="{StaticResource StatusTextStyle}" />
                        </Border>
                        <Border x:Name="LogStatusBorder" CornerRadius="10" Padding="12,7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="LogStatusText" Text="○ 日志关闭" Style="{StaticResource StatusTextStyle}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="SessionPicker" AutomationProperties.AutomationId="SessionPicker" AutomationProperties.Name="会话列表" MinWidth="200" MaxWidth="320" PlaceholderText="会话" SelectionChanged="SessionPicker_SelectionChanged" />
                    <Button x:Name="NewSessionButton" AutomationProperties.AutomationId="NewSessionButton" AutomationProperties.Name="新建会话" Content="新建" Click="NewSessionButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="保存当前会话并新建空白会话；生成中会先停止再切换" />
                    <Button x:Name="DeleteSessionButton" AutomationProperties.AutomationId="DeleteSessionButton" AutomationProperties.Name="删除当前会话" Content="删除" Click="DeleteSessionButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="删除当前会话（至少保留一个）；生成中会先停止再删除" />
                </StackPanel>

                <TextBlock x:Name="NoticeText" Grid.Row="2" Text="正在检查本地 Qwen3.5-9B 服务；长期记忆和磁盘日志默认关闭。" Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14" AutomationProperties.AutomationId="TranscriptShell">
                <ListView x:Name="TranscriptList" AutomationProperties.AutomationId="TranscriptList" AutomationProperties.Name="聊天记录" ItemsSource="{x:Bind TranscriptItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" Padding="8" Background="{StaticResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,16" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TranscriptEntry">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Label}" Foreground="{x:Bind LabelBrush}" Style="{StaticResource RoleLabelTextStyle}" VerticalAlignment="Center" />
                                    <Button Visibility="{x:Bind CopyVisibility}" AutomationProperties.AutomationId="CopyMessageButton" AutomationProperties.Name="复制整条回复" Tag="{x:Bind Text}" Click="CopyMessageButton_Click" Style="{StaticResource CopyMessageButtonStyle}" ToolTipService.ToolTip="复制整条回复">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind StreamingVisibility, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <local:MarkdownPresenter Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind FormattedVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Row="2" Margin="0,10,0,10" Padding="14,12,12,10" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="18">
                <Grid RowSpacing="8" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="0" AutomationProperties.AutomationId="MessageInput" AutomationProperties.Name="消息输入框" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="输入消息" MinHeight="52" MaxHeight="104" Padding="4,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" UseSystemFocusVisuals="False" FontFamily="Microsoft YaHei UI" FontSize="15" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_PreviewKeyDown" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button x:Name="ContinueButton" AutomationProperties.AutomationId="ContinueButton" AutomationProperties.Name="继续生成" Content="继续" Click="ContinueButton_Click" Style="{StaticResource ComposerSecondaryButtonStyle}" Visibility="Collapsed" ToolTipService.ToolTip="从上次中断处继续生成，或续写长文下一段" />
                        <Button x:Name="SendButton" AutomationProperties.AutomationId="SendButton" AutomationProperties.Name="发送消息" Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                    <!-- Spacing alone separates shortcuts (no · glyphs). -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="4,2,0,0">
                        <TextBlock Text="Enter 发送" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="Shift+Enter 换行" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="↑↓ 历史" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="生成中点发送可停止" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="「继续」=中断续写 ·「下一段」=长文分段" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Opacity="0.9" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="UseMemosToggle" AutomationProperties.AutomationId="UseMemosToggle" AutomationProperties.Name="使用 MemOS 长期记忆" OnContent="MemOS" OffContent="MemOS" MinWidth="0" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Left" Toggled="UseMemosToggle_Toggled" ToolTipService.ToolTip="MemOS 长期记忆" />
                    <ToggleSwitch x:Name="SaveLogsToggle" AutomationProperties.AutomationId="SaveLogsToggle" AutomationProperties.Name="保存聊天日志" OnContent="日志" OffContent="日志" MinWidth="0" Padding="0" HorizontalAlignment="Left" Toggled="SaveLogsToggle_Toggled" ToolTipService.ToolTip="保存聊天日志到磁盘" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="模型设置" Content="设置" Click="SettingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="MoreButton" AutomationProperties.AutomationId="MoreActionsButton" AutomationProperties.Name="更多操作" Content="更多" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="导出、日志目录、清空会话">
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem AutomationProperties.AutomationId="ExportConversationButton" Text="导出对话" Click="ExportButton_Click" />
                                <MenuFlyoutItem AutomationProperties.AutomationId="OpenLogsButton" Text="打开日志目录" Click="OpenLogsButton_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem AutomationProperties.AutomationId="ClearConversationButton" Text="清空当前会话" Click="ClearButton_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <local:RuntimeSettingsPanel
            x:Name="SettingsPanel"
            Grid.RowSpan="4"
            IsEnabled="False"
            IsHitTestVisible="False"
            Opacity="0" />

        <!-- Avoid ContentDialog (known WinUI native crash path). Compact actions, not oversized cards. -->
        <Grid
            x:Name="ClosePromptOverlay"
            Grid.RowSpan="4"
            Visibility="Collapsed"
            Background="#CC000000"
            IsHitTestVisible="False">
            <Border
                MaxWidth="400"
                MinWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="22,18"
                Background="{StaticResource RaisedBrush}"
                BorderBrush="{StaticResource StrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="ClosePromptTitle"
                            Text="退出 Qwen Local"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ClosePromptMessage"
                            Text="本机模型服务仍在运行。关闭时是否一并停止？"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="13"
                            LineHeight="19"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CloseStopModelHint"
                            Text="停止模型可释放 GPU/内存，改过的启动参数下次打开才生效。"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            LineHeight="17"
                            Foreground="{StaticResource TextMutedBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Button
                            x:Name="CloseStopModelButton"
                            AutomationProperties.AutomationId="CloseStopModelButton"
                            Content="停止模型并退出"
                            Click="CloseStopModelButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="结束本机 llama 服务" />
                        <Button
                            x:Name="CloseKeepModelButton"
                            AutomationProperties.AutomationId="CloseKeepModelButton"
                            Content="仅退出软件"
                            Click="CloseKeepModelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="模型在后台继续运行，下次可复用" />
                        <Button
                            x:Name="CloseCancelButton"
                            AutomationProperties.AutomationId="CloseCancelButton"
                            Content="取消"
                            Click="CloseCancelButton_Click"
                            HorizontalAlignment="Stretch"
                            MinHeight="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="13"
                            UseSystemFocusVisuals="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
